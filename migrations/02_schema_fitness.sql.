-- Проект: Фитнес-клуб
-- Миграция 02: нормализованная структура базы данных
-- Назначение: создание таблиц, первичных и внешних ключей

-- 1. Клиенты фитнес-клуба
CREATE TABLE clients (
    client_id SERIAL PRIMARY KEY, -- Уникальный идентификатор клиента
    full_name VARCHAR(100) NOT NULL, -- ФИО клиента
    phone VARCHAR(20), -- Номер телефона
    birth_date DATE -- Дата рождения
);

-- 2. Тренеры
CREATE TABLE trainers (
    trainer_id SERIAL PRIMARY KEY, -- Уникальный идентификатор тренера
    full_name VARCHAR(100) NOT NULL, -- ФИО тренера
    phone VARCHAR(20) -- Номер телефона тренера
);

-- 3. Справочник типов абонементов
CREATE TABLE memberships (
    membership_id SERIAL PRIMARY KEY, -- Уникальный идентификатор типа абонемента
    membership_name VARCHAR(100) NOT NULL UNIQUE, -- Название абонемента
    price NUMERIC(10, 2) NOT NULL CHECK (price >= 0), -- Стоимость абонемента
    duration_days INTEGER NOT NULL CHECK (duration_days > 0) -- Срок действия в днях
);

-- 4. Абонементы, оформленные клиентами
CREATE TABLE subscriptions (
    subscription_id SERIAL PRIMARY KEY, -- Уникальный идентификатор оформленного абонемента
    client_id INTEGER NOT NULL REFERENCES clients(client_id), -- Клиент
    membership_id INTEGER NOT NULL REFERENCES memberships(membership_id), -- Тип абонемента
    start_date DATE NOT NULL, -- Дата начала действия
    end_date DATE NOT NULL, -- Дата окончания действия
    CHECK (end_date >= start_date) -- Проверка периода действия
);

-- 5. Специализации тренеров
CREATE TABLE specializations (
    specialization_id SERIAL PRIMARY KEY, -- Уникальный идентификатор специализации
    specialization_name VARCHAR(100) NOT NULL UNIQUE -- Название специализации
);

-- 6. Связь тренеров со специализациями (многие ко многим)
CREATE TABLE trainer_specializations (
    trainer_id INTEGER NOT NULL REFERENCES trainers(trainer_id), -- Идентификатор тренера
    specialization_id INTEGER NOT NULL REFERENCES specializations(specialization_id), -- Идентификатор специализации
    qualification_level VARCHAR(50), -- Уровень квалификации тренера по специализации
    PRIMARY KEY (trainer_id, specialization_id) -- Составной первичный ключ
);

-- 7. Услуги фитнес-клуба
CREATE TABLE services (
    service_id SERIAL PRIMARY KEY, -- Уникальный идентификатор услуги
    service_name VARCHAR(100) NOT NULL UNIQUE, -- Название услуги
    price NUMERIC(10, 2) NOT NULL CHECK (price >= 0), -- Стоимость услуги
    description TEXT -- Описание услуги
);

-- 8. Групповые занятия
CREATE TABLE group_classes (
    class_id SERIAL PRIMARY KEY, -- Уникальный идентификатор занятия
    class_name VARCHAR(100) NOT NULL, -- Название занятия
    trainer_id INTEGER NOT NULL REFERENCES trainers(trainer_id), -- Тренер занятия
    service_id INTEGER REFERENCES services(service_id), -- Услуга, к которой относится занятие
    class_time TIMESTAMP NOT NULL, -- Дата и время занятия
    description TEXT -- Описание занятия
);

-- 9. Записи клиентов на групповые занятия (многие ко многим)
CREATE TABLE class_enrollments (
    client_id INTEGER NOT NULL REFERENCES clients(client_id), -- Клиент, записанный на занятие
    class_id INTEGER NOT NULL REFERENCES group_classes(class_id), -- Групповое занятие
    enrollment_date DATE NOT NULL DEFAULT CURRENT_DATE, -- Дата записи
    enrollment_status VARCHAR(30) NOT NULL DEFAULT 'Записан', -- Статус записи
    PRIMARY KEY (client_id, class_id) -- Один клиент записывается на занятие один раз
);

-- 10. Оборудование фитнес-клуба
CREATE TABLE equipment (
    equipment_id SERIAL PRIMARY KEY, -- Уникальный идентификатор оборудования
    equipment_name VARCHAR(100) NOT NULL UNIQUE, -- Название оборудования
    quantity INTEGER NOT NULL CHECK (quantity >= 0), -- Количество единиц оборудования
    condition_status VARCHAR(30) NOT NULL -- Состояние оборудования
);

-- 11. Посещения — таблица фактов, планируемый объём 300 000 строк
CREATE TABLE visits (
    visit_id BIGSERIAL PRIMARY KEY, -- Уникальный идентификатор посещения
    client_id INTEGER NOT NULL REFERENCES clients(client_id), -- Посетивший клуб клиент
    visit_time TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, -- Дата и время посещения
    purpose TEXT -- Цель посещения
);

-- 12. Платежи клиентов
CREATE TABLE payments (
    payment_id BIGSERIAL PRIMARY KEY, -- Уникальный идентификатор платежа
    client_id INTEGER NOT NULL REFERENCES clients(client_id), -- Клиент, совершивший оплату
    amount NUMERIC(10, 2) NOT NULL CHECK (amount >= 0), -- Сумма платежа
    payment_date TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, -- Дата и время платежа
    payment_method VARCHAR(30) NOT NULL, -- Способ оплаты
    comment TEXT -- Комментарий к платежу
);

-- Индекс для быстрого поиска посещений по времени
CREATE INDEX idx_visits_visit_time
ON visits (visit_time);

